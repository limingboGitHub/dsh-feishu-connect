{
  "name": "dsh-feishu-connect",
  "version": "1.2.2",
  "description": "Bridge Feishu (Lark) chats with a DeepSeek Harness agent conversation: official-SDK long connection (no public URL), cc-connect-style commands (/new /switch /list /help), per-chat sessions, typing reactions, markdown cards, and a settings-page UI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./helper": "./helper.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "helper.cjs",
    "cordis.patch.yml",
    "feishu.config.example.json",
    "README.md"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "cordis",
    "bot"
  ],
  "license": "MIT"
}
